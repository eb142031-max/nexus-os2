# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DARKLEYLA_BOOTSTRAP_TOKEN=replace-with-a-long-random-bootstrap-token
# Generate with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
DARKLEYLA_MASTER_KEY=replace-with-32-byte-base64-key
DATABASE_URL=sqlite:///./darkleyla_creator.db
DARKLEYLA_MEDIA_DIR=./private_media
DARKLEYLA_ALLOW_PAID_PROVIDER_CALLS=false

# Fanvue OAuth app credentials from https://www.fanvue.com/dev
FANVUE_CLIENT_ID=
FANVUE_CLIENT_SECRET=
FANVUE_REDIRECT_URI=https://YOUR-DOMAIN/oauth/fanvue/callback
FANVUE_SCOPES=read:self
FANVUE_API_VERSION=2025-06-26
